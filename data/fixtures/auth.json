{
  "schema_version": 1,
  "site": "https://dev.zhiyan.chat",
  "page": "/accounts",
  "rule": "授权对象只允许 data/shops.json 中的三家店。超管不开授权抽屉，不要拿超管测授/撤。测试账号从环境变量读取，不把真实密码写入本文件。",
  "superadmin": {
    "expected_hint": "超级管理员已拥有所有店铺的授权",
    "open_drawer": false
  },
  "operator": {
    "role": "普通员工",
    "username_env": "UI_TEST_EMPLOYEE_USERNAME",
    "password_env": "UI_TEST_EMPLOYEE_PASSWORD",
    "note": "使用已有测试员工；不要一次新建20个真账号。历史非 UI 店授权只读记录，不点授权或取消。"
  },
  "allowed_shop_ids": [740, 738, 739],
  "allowed_shop_names": [
    "UI货品回归店铺B1_20260831_01",
    "UI货品回归店铺A1_20260831_01",
    "UI货品回归店铺A2_20260831_01"
  ],
  "cases": [
    {
      "id": "AUTH-01",
      "name": "未授权再授权单店B1",
      "steps": ["打开未授权页签", "搜索B1", "授权"],
      "assert": "B1出现在已授权，未授权列表不再含B1"
    },
    {
      "id": "AUTH-02",
      "name": "已授权取消B1",
      "steps": ["打开已授权页签", "取消B1"],
      "assert": "B1回到未授权"
    },
    {
      "id": "AUTH-03",
      "name": "单店授撤A1",
      "shop_key": "A1"
    },
    {
      "id": "AUTH-04",
      "name": "单店授撤A2",
      "shop_key": "A2"
    },
    {
      "id": "AUTH-05",
      "name": "批量授权三店",
      "steps": ["未授权勾选B1+A1+A2", "批量授权"],
      "assert": "三店均在已授权；不得勾选白名单以外的店"
    },
    {
      "id": "AUTH-06",
      "name": "批量取消授权三店",
      "steps": ["已授权勾选三店", "批量取消授权"],
      "assert": "三店均回到未授权"
    }
  ],
  "restore": "套件结束将测试员工恢复为仅保留B1授权，A1/A2按后续用例需要再授。",
  "volume_note": "允许操作的店只有3家，不能做成20家店授权。大量断言改为对这3家反复授撤，或改测店内20条业务数据。"
}
